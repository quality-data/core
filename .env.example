# Example environment for the quality-data stack (bead authapp-242382).
#
# Copy to `.env` and adjust — `docker compose` auto-loads `./.env`:
#
#   cp .env.example .env
#   docker compose --profile dev up --build
#
# The values here are DEV placeholders, safe to commit as an example. They are
# NOT secrets — change every password/secret before any real deployment, and in
# production supply secrets via Docker secrets (see compose.prod.yml), not this
# file. `.env` itself is git-ignored.
#
# Legend:  (required) must be set   ·   default shown when a variable is optional.

# ─── Edge / Traefik ──────────────────────────────────────────────────────────
# Public hostname the app is served on; Traefik routes this host and requests a
# Let's Encrypt certificate for it. `localhost` is fine for local dev (no cert).
APP_DOMAIN=localhost
# Contact address on the issued TLS certificates. (required by the edge stack)
ACME_EMAIL=you@example.com

# ─── Application (API) ───────────────────────────────────────────────────────
# Address the API binds inside its container (compose sets 0.0.0.0:8080).
APP_HOST=0.0.0.0
APP_PORT=8080
# Comma-separated browser origins allowed by CORS (never a wildcard). Empty in a
# same-origin deployment behind Traefik.
CORS_ALLOWED_ORIGINS=
# Log level / filter for the JSON logs (tracing EnvFilter). default: info
RUST_LOG=info
# The machine's name, the `vm` field of every log line and Alloy's `vm` label
# (decision 0026, point 1); the installer writes the host's. default: dev
# OBS_VM=dev

# ─── Database (API connection) ───────────────────────────────────────────────
# Connection string the API uses. In compose this is composed from the app role
# + password below; set it directly only when running the API without compose.
# In production prefer DATABASE_URL_FILE (a Docker secret) over a plain value.
# DATABASE_URL=postgres://quality_data_app:change-me@localhost:5432/quality_data?sslmode=disable
# DATABASE_URL_FILE=/run/secrets/database_url
# With machine certificates (infra/postgres/tls.yml, decision 0066 step 8)
# nothing reaches PostgreSQL without TLS: the host is POSTGRES_SERVER_NAME,
# the name in its certificate (the application VM's machine name), verified
# against the installation's CA, e.g.
# DATABASE_URL=postgres://quality_data_app:change-me@qd-app:5432/quality_data?sslmode=verify-full&sslrootcert=/etc/qd/ca.crt
# Development keeps sslmode=disable until the dev stack moves.
# Pool tuning (optional).  defaults: 10 / 0 / 30
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=0
DATABASE_ACQUIRE_TIMEOUT_SECS=30

# ─── Postgres container (compose) ────────────────────────────────────────────
# Bootstrap superuser — used only for administration/migrations/backups, never
# by the app. (POSTGRES_SUPERUSER_PASSWORD required)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
POSTGRES_DB=quality_data
# Least-privilege application role the API connects as. (APP_DB_PASSWORD required)
APP_DB_USER=quality_data_app
APP_DB_PASSWORD=change-me-app
# Scheduled-backup sidecar (compose `--profile backup`).  defaults: 86400 / 7
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION=7

# ─── First administrator (bootstrap-admin) ───────────────────────────────────
# Used by `server bootstrap-admin` (the dev compose runs it once). The password
# must satisfy the policy below. (ADMIN_BOOTSTRAP_PASSWORD required to bootstrap)
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-Str0ng!

# ─── Production images (compose.prod.yml) ────────────────────────────────────
# Versioned, registry-hosted image tags for prod (no local build). (required for prod)
# IMAGE_API / IMAGE_WEB win when set (the update agent writes them, with
# IMAGE_TRAEFIK and IMAGE_POSTGRES); API_IMAGE / WEB_IMAGE are the fallback.
# API_IMAGE=ghcr.io/your-org/quality-data-api:v1.0.0
# WEB_IMAGE=ghcr.io/your-org/quality-data-web:v1.0.0

# ─── Password hashing (Argon2id) ─────────────────────────────────────────────
# OWASP-recommended defaults are used when unset. Tune only with benchmarking.
# ARGON2_MEMORY_KIB=19456
# ARGON2_ITERATIONS=2
# ARGON2_PARALLELISM=1

# ─── Admin password policy ───────────────────────────────────────────────────
# Sensible defaults apply when unset.
# ADMIN_PASSWORD_MIN_LENGTH=12
# ADMIN_PASSWORD_REQUIRE_UPPERCASE=true
# ADMIN_PASSWORD_REQUIRE_LOWERCASE=true
# ADMIN_PASSWORD_REQUIRE_DIGIT=true
# ADMIN_PASSWORD_REQUIRE_SYMBOL=true

# ─── Account/IP lockout ──────────────────────────────────────────────────────
# ADMIN_LOCKOUT_MAX_ATTEMPTS=5
# ADMIN_LOCKOUT_BASE_SECONDS=30
# ADMIN_LOCKOUT_MAX_SECONDS=3600

# ─── Sessions ────────────────────────────────────────────────────────────────
# SESSION_IDLE_TIMEOUT_SECS=1800
# SESSION_ABSOLUTE_TIMEOUT_SECS=43200

# ─── System settings (the Settings screen) ───────────────────────────────────
# LDAP, outgoing mail (Office 365 over Microsoft Graph, or SMTP) and the OAuth
# providers are edited in the UI, admin only, and apply without restarting.
# What is saved there wins; a section never saved uses the LDAP_* / OAUTH_*
# variables below. The secrets are stored encrypted (AES-256-GCM) with this
# key: 32 bytes in base64 (`openssl rand -base64 32`). Empty, the file
# SETTINGS_KEY_FILE is used (and generated the first time). If the key is lost,
# the passwords and secrets have to be typed again in the UI.
SETTINGS_ENCRYPTION_KEY=
# SETTINGS_KEY_FILE=/var/lib/quality-data/settings/settings.key

# ─── Password recovery ───────────────────────────────────────────────────────
# The link is sent with the outgoing mail of Settings (without mail, recovery
# answers 503). Local accounts only: LDAP / AD ones get a notice to change it
# in the directory; OAuth ones, with their provider.
# How many minutes the link works (30 by default). Settings → Mail can set
# another value without restarting; this one stays as the default.
# PASSWORD_RESET_TTL_MINUTES=30
# The UI's public address for the links (on-premise). If missing,
# OAUTH_REDIRECT_BASE without the trailing /api is used.
# APP_PUBLIC_URL=https://localhost

# ─── OAuth2 / OIDC sign-in (optional) ────────────────────────────────────────
# Comma-separated provider ids to enable (e.g. `google`). Leave empty to disable
# OAuth entirely (the login page then shows no provider buttons).
OAUTH_PROVIDERS=
# Externally reachable base of the API the provider redirects back to; behind
# Traefik that includes the /api prefix. Also used by providers set up in the UI.
# OAUTH_REDIRECT_BASE=https://localhost/api
# Where the SPA lands after sign-in.  defaults: / and /login
# OAUTH_SUCCESS_REDIRECT=/
# OAUTH_FAILURE_REDIRECT=/login
# Per-provider settings — repeat for each id in OAUTH_PROVIDERS, uppercased.
# For OAUTH_PROVIDERS=google:
# OAUTH_GOOGLE_CLIENT_ID=change-me
# OAUTH_GOOGLE_CLIENT_SECRET=change-me
# OAUTH_GOOGLE_AUTH_ENDPOINT=https://accounts.google.com/o/oauth2/v2/auth
# OAUTH_GOOGLE_TOKEN_ENDPOINT=https://oauth2.googleapis.com/token
# OAUTH_GOOGLE_USERINFO_ENDPOINT=https://openidconnect.googleapis.com/v1/userinfo
# OAUTH_GOOGLE_ISSUER=https://accounts.google.com
# OAUTH_GOOGLE_SCOPES=openid,email

# ─── This installation as an OIDC provider (optional) ────────────────────────
# Other applications (gestión, billing…) let their users sign in with the
# accounts here: authorization code flow with PKCE (S256), tokens signed with
# Ed25519 (EdDSA). Empty, off. It is a secret: `server oidc-keygen`.
# OIDC_SIGNING_KEY=
# To rotate it without cutting anyone off: the new one in OIDC_SIGNING_KEY and
# the previous one here (several, comma-separated). What was signed with it
# stays valid and is listed in /oauth/jwks; remove it once its tokens expire
# (15 min) and the clients have read the JWK Set again (a day is enough).
# OIDC_SIGNING_KEY_PREVIOUS=
# A second key, ECDSA P-256 (ES256), for the applications set to it
# (`--alg ES256`: for clients that verify only RSA or EC keys). Empty, those
# applications cannot sign in. A secret: `server oidc-keygen --es256`; rotated
# the same way, with OIDC_SIGNING_KEY_ES256_PREVIOUS. Both signing keys can
# also come from a file, in OIDC_SIGNING_KEY_FILE / OIDC_SIGNING_KEY_ES256_FILE.
# OIDC_SIGNING_KEY_ES256=
# OIDC_SIGNING_KEY_ES256_PREVIOUS=
# The tokens' issuer; by default APP_PUBLIC_URL + /api, where
# /.well-known/openid-configuration and /oauth/{authorize,token,userinfo,jwks} live.
# OIDC_ISSUER=https://localhost/api
# The applications are registered with
#   server oidc-client ID NAME REDIRECT_URI... [--public] [--alg ES256]
#     [--no-pkce] [--require-policy NAME]
#     [--client-credentials --audience A [--service-account ID]
#     [--machine-role ROLE]]
# (without --public it gets a secret, shown only once) and changed with
#   server oidc-client-update ID [the same options]
# With --machine-role (worker, app, …; no redirect URI) the client
# has no secret: an approved or draining machine of that role asks for its
# 15-minute token with its certificate, on the internal entry point, which
# needs INTERNAL_CLIENT_CERT_HEADER=trusted (decision 0066), e.g.
#   server oidc-client qd-worker Workers --machine-role worker \
#     --client-credentials --audience quality-api

# ─── The installation's CA (decision 0066) ───────────────────────────────────
# It signs the machines' certificates; made once by `server ca-init --name
# INSTALLATION --cert PATH --key PATH`. The key is a secret: only as a file.
# CA_CERT_FILE=/run/secrets/ca.crt
# CA_KEY_FILE=/run/secrets/ca.key
# In development infra/traefik/gen-dev-internal.sh makes it in .dev/ca and turns
# on Traefik's internal entry point for INTERNAL_DOMAIN (default
# internal.<APP_DOMAIN>), reached on 443 by that name (SNI); its own port is
# on Traefik's loopback alone. TRAEFIK_INTERNAL_PORT (443) is where the API
# reaches it.
# TRAEFIK_INTERNAL_PORT=443
# The API asks there each installed application module for its drain
# (decision 0003, /modules/<name><drain_path>), with LAKE_CLIENT_CERT_FILE.
# The lake's gates ask the API there whether a machine may reach RustFS
# (decision 0066, point 10), on an entry point of their own, reached on 443
# by lakegate.<INTERNAL_DOMAIN>.
# Where a joined machine's Alloy pushes its metrics, in its join command
# (decision 0071): by default Mimir on 443 as mimir.<INTERNAL_DOMAIN>.
# MACHINES_METRICS_PUSH_URL=https://mimir.qd-app/api/v1/push
# Where the API reads the machines' charts (decision 0072, point 13): Mimir's
# Prometheus API through this VM's Traefik (only role app reads, 0071),
# presenting LAKE_CLIENT_CERT_FILE and trusting LAKE_CA_FILE; plain HTTP in a
# development without TLS. Unset, Settings → Machines says "metrics not
# available".
# MIMIR_QUERY_URL=https://mimir.qd-app/prometheus
# The lake admin adapter (decision 0078): the main lake's at LAKE_ADMIN_URL
# (with the lake-rustfs module, https://admin.<lake machine>, the name its
# gate passes through on 443; a replica's at admin.<its machine>:443), the API presenting LAKE_ADMIN_CERT_FILE
# (by default LAKE_CLIENT_CERT_FILE) and trusting LAKE_ADMIN_CA_FILE alone (by
# default CA_CERT_FILE). In development infra/rustfs/gen-dev-lake-admin.sh
# makes their files in .dev/lake-admin, and compose.override.yml and
# tools/dev/api.sh set them. Unset, Settings → Lake says it is not reachable.
# LAKE_ADMIN_URL=https://lake-admin.internal.localhost
# LAKE_ADMIN_CA_FILE=/run/secrets/ca.crt
# LAKE_ADMIN_CERT_FILE=/run/qd-node/machine.pem
# On a lake node, with infra/rustfs/gate.yml: its name as in its certificate,
# and where its gate asks.
# QD_MACHINE_NAME=lake-1
# QD_LAKE_CHECK_URL=https://lakegate.internal.localhost/api/internal/machines/lake/check
# With the gate, the application reaches the lake presenting its VM's machine
# certificate: the API by its agent's machine.pem (read again when renewed),
# its Traefik by a copy of it in its dynamic directory (app-machine.pem).
# On a worker, with infra/worker/lake.yml: the gate its proxy reaches (the
# worker gets QD_LAKE_URL, the proxy on its loopback, from that file).
# QD_LAKE_GATE=lake-1:443
# LAKE_CLIENT_CERT_FILE=/run/qd-node/machine.pem
# LAKE_TRANSPORT=lake@file
# LAKE_SERVER_NAME=lake-1
# RUSTFS_URL=https://lake-1
# INTERNAL_DOMAIN=internal.localhost
# Where the Trino coordinator runs on this machine, its TLS address on
# Traefik's network: Traefik passes trino.<INTERNAL_DOMAIN> on 443 through to
# it, and the coordinator publishes no port (decision 0090, ruling 90).
# TRINO_UPSTREAM=engine-trino-coordinator:443
# The orchestrator's internal routes: the core makes its own flow there at start
# and hands it the jobs a person asks for (records, map, tables, test_rule,
# console), with the core's machine certificate (LAKE_CLIENT_CERT_FILE,
# LAKE_CA_FILE) and its own token for ORCHESTRATOR_AUDIENCE (decision 0090,
# rulings 97, 100 and 103). Unset, nothing is handed over.
# ORCHESTRATOR_INTERNAL_URL=https://qd-app/modules/orchestrator/internal
# ORCHESTRATOR_AUDIENCE=orchestrator
# ORCHESTRATOR_CORE_FLOW_TIMEOUT=3600
# A machine renews its certificate there, and asks for its OIDC token, and the
# API reads it from Traefik's X-Forwarded-Tls-Client-Cert only with this set to
# `trusted`. Only where the API cannot be reached but through Traefik: whoever
# reaches it directly could write that header. Unset, renewing answers 503 and
# no machine role's client gets a token.
# INTERNAL_CLIENT_CERT_HEADER=trusted

# ─── LDAP / Active Directory sign-in ─────────────────────────────────────────
# Empty = local accounts only. The user signs in with their UPN or email
# (ana@empresa.com). Whoever is neither in LDAP_ADMIN_GROUPS nor in a group
# mapped to an area (the "Áreas y acceso" screen) cannot sign in.
LDAP_URL=
# LDAP_URL=ldaps://dc01.empresa.local:636
# LDAP_STARTTLS=false          # true with ldap://...:389 + StartTLS
# LDAP_CA_CERT=/run/certs/ca-interna.pem   # the CA that signs the DC's certificate (also
#                                          # applies with LDAP configured from the page)
# LDAP_TLS_INSECURE=false      # tests only: does not verify the certificate
# LDAP_BIND_DN=CN=svc-quality-data,OU=Servicios,DC=empresa,DC=local
# LDAP_BIND_PASSWORD=          # or LDAP_BIND_PASSWORD_FILE in production
# LDAP_BASE_DN=DC=empresa,DC=local
# LDAP_USER_FILTER=(&(objectClass=user)(|(userPrincipalName={login})(mail={login})))
# Groups (full DN, separated by ;) whose members are administrators.
# LDAP_ADMIN_GROUPS=CN=QualityData-Admins,OU=Grupos,DC=empresa,DC=local

# RustFS (infra/rustfs): the lake's S3 storage, its console at /rustfs/console/.
# Root credentials: random values of your own.
RUSTFS_ACCESS_KEY=change-me
RUSTFS_SECRET_KEY=change-me-too
# Sign in to the console with Quality Data: `on`, and the secret printed by
#   server oidc-client rustfs "RustFS" https://<domain>/rustfs/admin/v3/oidc/callback/default
RUSTFS_OIDC_ENABLE=off
RUSTFS_OIDC_CLIENT_SECRET=
# The platform's issuer of per-job lake credentials (STS, decision 0030):
# made and appended here by infra/rustfs/sts-issuer.sh.
RUSTFS_STS_ISSUER_ACCESS_KEY=
RUSTFS_STS_ISSUER_SECRET_KEY=
# RustFS's object data cache (decision 0028, point 5): on in the lake's
# composes (infra/rustfs, pool/, replica/), whole objects up to 10 MiB in
# memory, never stale. The process grows up to ~170 MiB above the cap while
# filling. On a lake node, the same lines go in its .env. The defaults:
# RUSTFS_OBJECT_DATA_CACHE_ENABLE=true
# RUSTFS_OBJECT_DATA_CACHE_MODE=fill_materialize_enabled
# RUSTFS_OBJECT_DATA_CACHE_MAX_BYTES=268435456
# RUSTFS_OBJECT_DATA_CACHE_MAX_ENTRY_BYTES=10485760
# RUSTFS_OBJECT_DATA_CACHE_TTL_SECS=300

# Observability (infra/observability, decision 0026): Grafana at /grafana,
# Loki with its storage in the lake, Alloy collecting the containers' logs.
# Grafana's emergency admin (user qd-emergency-admin, GRAFANA_ADMIN_USER to
# rename it), the only local account: /grafana/login?disableAutoLogin=true.
# Grafana's secrets are files, not variables: secrets/grafana_admin_password
# (random) and secrets/grafana_oidc_client_secret (the secret printed by
#   server oidc-client grafana Grafana https://<domain>/grafana/login/generic_oauth \
#     --home https://<domain>/grafana/ --detail "Auditoría y registros"),
# written once by infra/observability/setup-secrets.sh (task obs:up runs it).
# The folder of secret files, relative to the repository (default ./secrets).
# QD_SECRETS_DIR=./secrets
# Grafana reads the audit and run logs as the read-only PostgreSQL role
# qd_grafana (infra/postgres/grafana-role.sh; tools/dev/grafana-role.sh,
# which task obs:up runs), its password in secrets/grafana_pg_password.
# The CA that PostgreSQL's certificate is verified against (verify-full at
# POSTGRES_SERVER_NAME). Required in production: unset, nothing is trusted.
# Development connects without TLS and mounts the dev CA by default:
# GRAFANA_PG_CA_FILE=./infra/traefik/certs/dev-ca.crt
# Loki's own RustFS user, limited to its bucket (qd-observability): made and
# appended here by infra/observability/setup-storage.sh.
LOKI_S3_ACCESS_KEY=
LOKI_S3_SECRET_KEY=
# Mimir's, the same way, limited to its bucket (qd-metrics; decision 0071).
MIMIR_S3_ACCESS_KEY=
MIMIR_S3_SECRET_KEY=
# How long the services' metrics stay in the lake (13 months by default,
# decision 0071, point 2):
# MIMIR_RETENTION=395d
# The machines' alerts (decision 0072): Grafana mails them to these role
# mailboxes, separated by `;` (never a person's address in the repository),
# and the installer asks for them; changed by editing this line and
# restarting Grafana. Required. In development they reach Mailpit
# (http://127.0.0.1:8026), whatever they are.
GRAFANA_ALERT_EMAILS=alerts@example.org
# Grafana's own SMTP for that mail (point 9): copied once from Settings →
# Mail by the installer, not kept in sync with it. Its password is the file
# secrets/grafana_smtp_password (setup-secrets.sh), empty without
# authentication. Grafana requires STARTTLS (MandatoryStartTLS), and a
# private mail server's CA in GRAFANA_SMTP_CA_FILE. Development sends to
# Mailpit without these (infra/observability/compose.dev.yml).
# GF_SMTP_ENABLED=true
# GF_SMTP_HOST=smtp.example.org:587
# GF_SMTP_USER=alerts@example.org
# GF_SMTP_FROM_ADDRESS=alerts@example.org
# GRAFANA_SMTP_CA_FILE=/etc/ssl/smtp-ca.crt

# Dolt (infra/dolt): the versioned catalog, one database per tenant
# (decision 0021). Only the application connects, as `qd_app`; root stays
# inside the container. Random values of your own (hex: no URL escaping).
DOLT_ROOT_PASSWORD=
DOLT_APP_PASSWORD=
# What the API uses; in development the stack publishes 127.0.0.1:3307.
# DOLT_URL=mysql://qd_app:<DOLT_APP_PASSWORD>@127.0.0.1:3307
# Or the URL with the user only and the password in DOLT_PASSWORD (or a
# file, DOLT_PASSWORD_FILE), as the core's package runs it (decision 0080).
# DOLT_PORT=3307
# With the machines' certificates (infra/dolt/certificate.yml, decision 0066
# step 10; not the dev stack yet) Dolt serves TLS only with the application
# VM's machine certificate and requires one of the installation's CA: the
# API presents that machine's (its node agent's directory, QD_MACHINE_DIR)
# and verifies Dolt's name, the application VM's machine name, which must
# resolve to where DOLT_BIND:DOLT_PORT is published:
# DOLT_URL=mysql://qd_app:<DOLT_APP_PASSWORD>@qd-app:3306?ssl-mode=VERIFY_IDENTITY&ssl-ca=/run/qd-node/ca.crt&ssl-cert=/run/qd-node/machine.pem&ssl-key=/run/qd-node/machine.pem
# DOLT_BIND=127.0.0.1
# tenant.sh and backup.sh then take
# DOLT_COMPOSE_FILES="-f infra/dolt/docker-compose.yml -f infra/dolt/certificate.yml"
# and the application VM's node agent (rolling) restarts Dolt when it is
# free to give it the renewed certificate:
# QD_DOLT_RESTART="docker restart data-quality-dolt-dolt-1"
# QD_DOLT_ADDR=qd-app:3306
# The lake with the machines' certificates (infra/rustfs/certificate.yml,
# decision 0066 step 10; not the dev stack yet), on each lake node: its node
# agent's directory (the agent runs as RustFS's uid 10001) and, awaiting the
# user's ruling, client certificates not required (DuckDB cannot present one):
# QD_MACHINE_DIR=/var/lib/qd-node
# RUSTFS_MTLS=0
# The API (LAKE_CA_FILE) and the workers (QD_CA_FILE) trust the installation's CA.
# The semantic patterns a map job profiles and proposes rules with (decision
# 0038): a JSON object with the ones to change (email, mobile, document,
# date, number, flag); the rest are Colombia's. Each must be a pattern DuckDB
# takes, or the server does not start. Or QUALITY_SEMANTIC_PATTERNS_FILE.
# QUALITY_SEMANTIC_PATTERNS={"mobile": "3\\d{9}"}
# Copy of the catalog backups to the lake's bucket (qd-backups/dolt): a RustFS
# user limited to that prefix. Written by infra/dolt/lake-backup-user.sh.
DOLT_BACKUP_S3_ACCESS_KEY=
DOLT_BACKUP_S3_SECRET_KEY=
# DOLT_BACKUP_S3_URL=http://127.0.0.1:9000   # RustFS's S3 API, as seen by the copy
# DOLT_BACKUP_BUCKET=qd-backups

# Development: the workers' machine client, for its API tokens
# (client_credentials); the secret printed by
#   server oidc-client qd-worker-dev "Quality Data worker (dev)" --client-credentials --audience quality-api --alg ES256
# This secret mode is for development only and goes when the dev stack moves
# to certificates (decision 0066, step 8). A production worker
# (infra/worker/docker-compose.yml) holds no secret: its node agent joins
# with QD_MACHINE_NAME, QD_CA_SHA256 and the token in QD_JOIN_TOKEN_DIR/token,
# and the worker, with QD_MACHINE_DIR, asks its token with the machine's
# certificate for the role's client (QD_WORKER_CLIENT_ID, default qd-worker,
# registered with --machine-role worker) at the internal entry point
# (QD_INTERNAL_URL, https://<INTERNAL_DOMAIN>/api, on 443), and opens the queue
# with it too (QD_QUEUE_DATABASE_URL without a password, TLS verify-full).
QD_WORKER_DEV_CLIENT_SECRET=
# Development: the dev SQL Server source (task sqlserver:load writes them the
# first time, never printed).
SQLSERVER_SA_PASSWORD=
SQLSERVER_READER_PASSWORD=

# The queue's PostgreSQL role, for the workers (decision 0023): it can only
# take, renew and finish jobs. Created with the database; on an existing one
# run tools/dev/queue-role.sh, which also generates this value. Development
# only: with infra/postgres/tls.yml the role has no password and a worker
# opens the queue with its machine's certificate (decision 0066, step 8);
# that overlay also needs QD_MACHINE_DIR (the application VM's node agent
# directory) and POSTGRES_SERVER_NAME.
QD_QUEUE_PASSWORD=
